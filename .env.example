DATABASE_URL="file:./dev.db"
# Hosted database used on Vercel so every visitor shares accounts, submissions, and the leaderboard.
# Create one free database at https://turso.tech, then set both values in the Vercel project.
# Leave them empty for local development. Local data stays in the SQLite file above.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
AUTH_SECRET="replace-with-a-long-random-string"
# Set AUTH_URL in production to the public site address.
# Leave it unset locally so sign-in follows whichever port Next.js uses.
# Required before anyone can create a judge account. Use a long random value and share it only with judges.
JUDGE_INVITE_CODE=""
# Optional local-only password for the sample judge accounts. Ignored in production.
DEMO_JUDGE_PASSWORD=""
SHOW_DEMO_ACCOUNTS="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Brunel Hackathon <hackathon@brunel.ac.uk>"
